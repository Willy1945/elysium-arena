# Elysium Arena - Frontend Environment Variables
# Copy this to .env or configure in Vercel / Netlify dashboard

# Base URL to Laravel REST API Backend (must include /api)
VITE_API_URL=http://127.0.0.1:8000/api

# For production hosting, example:
# VITE_API_URL=https://api.elysiumarena.com/api
# or
# VITE_API_URL=https://elysium-backend-production.up.railway.app/api
